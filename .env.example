# Copy this file to .env (git ignores .env) and fill in the values. Never commit real keys.

# Gemini key from Google AI Studio, created inside the Ripple Google Cloud project and restricted to the Gemini API.
GEMINI_API_KEY=

# Old Ripple (backend/ and frontend/) only, until the rebuild replaces it.
RIPPLE_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
